{
  "name": "visualizer-components",
  "version": "0.4.0",
  "description": "Humber ASV telemetry visualizer — React components, Redux slices, MUI themes, and basestation connection utilities built on @react-spring/web, @use-gesture, MUI and Redux Toolkit.",
  "license": "MIT",
  "author": "Carson Fujita",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bun --hot demo/index.ts",
    "sync-dev": "bun --hot demo/index.ts --live",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js",
    "docs": "typedoc",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "@mui/material": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "isometric-physics": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-isometric-engine": "^1.1.1",
    "react-redux": "^9.0.0"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@use-gesture/react": "^10.3.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.35.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/selenium-webdriver": "^4.1.28",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "isometric-physics": "^1.0.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-isometric-engine": "^1.1.1",
    "react-redux": "^9.3.0",
    "selenium-webdriver": "^4.46.0",
    "ts-jest": "^29.4.11",
    "typedoc": "^0.28.20",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0"
  }
}
